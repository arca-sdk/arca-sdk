# ARCA/AFIP credentials are read only on the TanStack Start server.
# Do not prefix these with VITE_ and do not expose them in client code.

ARCA_ENVIRONMENT=homologacion
ARCA_CUIT=20123456789

# Prefer file paths for local development. The root .gitignore ignores certs/.
ARCA_CERTIFICATE_PATH=./certs/certificate.crt
ARCA_PRIVATE_KEY_PATH=./certs/private.key

# Alternatively, provide PEM values inline. Escaped newlines (\n) are supported.
# ARCA_CERTIFICATE="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# ARCA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Only required when your private key is encrypted.
ARCA_PRIVATE_KEY_PASSPHRASE=

# WSAA ticket cache directory. The root .gitignore ignores .arca-cache/.
ARCA_CACHE_DIR=.arca-cache/wsaa
